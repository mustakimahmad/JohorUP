# Production Environment Configuration
# Copy this file to .env.production and fill in the actual values

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================
DATABASE_URL="postgresql://johorup_user:SECURE_PASSWORD@your-db-host:5432/johorup_production?sslmode=require"
DATABASE_SSL=true

# =============================================================================
# APPLICATION CONFIGURATION
# =============================================================================
NODE_ENV=production
NEXT_PUBLIC_APP_URL="https://johorup.jpnj.gov.my"
NEXTAUTH_URL="https://johorup.jpnj.gov.my"
NEXTAUTH_SECRET="your-super-secure-32-character-secret-key-here"

# =============================================================================
# AUTHENTICATION & SECURITY
# =============================================================================
JWT_SECRET="your-jwt-secret-key-minimum-32-characters"
ENCRYPTION_KEY="your-32-character-encryption-key-here"
SESSION_SECRET="your-session-secret-key-here"

# Password requirements
MIN_PASSWORD_LENGTH=8
REQUIRE_SPECIAL_CHARS=true
REQUIRE_NUMBERS=true

# =============================================================================
# EMAIL CONFIGURATION (for notifications)
# =============================================================================
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER="noreply@jpnj.gov.my"
SMTP_PASS="your-email-app-password"
FROM_EMAIL="Sistem JohorUP <noreply@jpnj.gov.my>"

# =============================================================================
# FILE STORAGE (AWS S3 or compatible)
# =============================================================================
# AWS S3 Configuration
AWS_ACCESS_KEY_ID="your-aws-access-key"
AWS_SECRET_ACCESS_KEY="your-aws-secret-key"
AWS_REGION="ap-southeast-1"
AWS_BUCKET_NAME="johorup-files-production"

# Alternative: CloudFlare R2 (S3 compatible)
# R2_ACCOUNT_ID="your-cloudflare-account-id"
# R2_ACCESS_KEY_ID="your-r2-access-key"
# R2_SECRET_ACCESS_KEY="your-r2-secret-key"
# R2_BUCKET_NAME="johorup-files"

# File upload limits
MAX_FILE_SIZE=10485760  # 10MB in bytes
ALLOWED_FILE_TYPES="pdf,doc,docx,xls,xlsx,jpg,jpeg,png"

# =============================================================================
# MONITORING & LOGGING
# =============================================================================
# Sentry for error tracking
SENTRY_DSN="https://your-sentry-dsn@sentry.io/project-id"
SENTRY_ENVIRONMENT="production"

# Analytics
NEXT_PUBLIC_GOOGLE_ANALYTICS="G-XXXXXXXXXX"

# Logging level
LOG_LEVEL="info"

# =============================================================================
# RATE LIMITING & SECURITY
# =============================================================================
# Rate limiting (requests per minute)
RATE_LIMIT_LOGIN=5
RATE_LIMIT_API=100
RATE_LIMIT_UPLOAD=10

# CORS settings
ALLOWED_ORIGINS="https://johorup.jpnj.gov.my,https://www.jpnj.gov.my"

# Security headers
ENABLE_CSP=true
ENABLE_HSTS=true

# =============================================================================
# BACKUP CONFIGURATION
# =============================================================================
# Database backup
BACKUP_SCHEDULE="0 2 * * *"  # Daily at 2 AM
BACKUP_RETENTION_DAYS=30

# Backup storage
BACKUP_S3_BUCKET="johorup-backups"
BACKUP_ENCRYPTION_KEY="your-backup-encryption-key"

# =============================================================================
# NOTIFICATION SETTINGS
# =============================================================================
# Admin notification emails
ADMIN_EMAILS="admin@jpnj.gov.my,koordinator@jpnj.gov.my"

# System alerts
ENABLE_ERROR_NOTIFICATIONS=true
ENABLE_MAINTENANCE_NOTIFICATIONS=true
ENABLE_BACKUP_NOTIFICATIONS=true

# =============================================================================
# FEATURE FLAGS
# =============================================================================
ENABLE_MAINTENANCE_MODE=false
ENABLE_USER_REGISTRATION=false
ENABLE_FILE_UPLOAD=true
ENABLE_EXCEL_EXPORT=true
ENABLE_ANALYTICS=true

# =============================================================================
# PERFORMANCE SETTINGS
# =============================================================================
# Database connection pooling
DB_POOL_MIN=2
DB_POOL_MAX=10

# Cache settings
REDIS_URL="redis://your-redis-host:6379"
CACHE_TTL=3600  # 1 hour

# CDN settings
CDN_URL="https://cdn.johorup.jpnj.gov.my"

# =============================================================================
# INTEGRATION SETTINGS
# =============================================================================
# Government systems integration (if applicable)
GOV_API_ENDPOINT="https://api.gov.my/johor-education"
GOV_API_KEY="your-government-api-key"

# Single Sign-On (if applicable)
SSO_ENABLED=false
SSO_PROVIDER="azure-ad"
SSO_CLIENT_ID="your-sso-client-id"
SSO_CLIENT_SECRET="your-sso-client-secret"

# =============================================================================
# MAINTENANCE SETTINGS
# =============================================================================
MAINTENANCE_MODE=false
MAINTENANCE_MESSAGE="Sistem sedang diselenggara. Sila cuba lagi kemudian."
MAINTENANCE_ALLOWED_IPS="192.168.1.100,10.0.0.50"  # Admin IPs

# =============================================================================
# AUDIT & COMPLIANCE
# =============================================================================
ENABLE_AUDIT_LOG=true
AUDIT_RETENTION_DAYS=365
ENABLE_DATA_ENCRYPTION=true

# Privacy settings
DATA_RETENTION_YEARS=7
ENABLE_GDPR_COMPLIANCE=true

# =============================================================================
# DEVELOPMENT/DEBUG (Set to false in production)
# =============================================================================
DEBUG=false
ENABLE_DEBUG_LOGS=false
SHOW_ERROR_DETAILS=false