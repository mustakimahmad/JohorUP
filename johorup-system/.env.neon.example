# Production Environment Configuration - Netlify + Neon
# Copy this file to .env.production and fill in the actual values

# =============================================================================
# DATABASE CONFIGURATION (Neon PostgreSQL)
# =============================================================================
DATABASE_URL="postgresql://username:password@ep-xxx.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"
DATABASE_SSL=true

# Neon specific settings
NEON_PROJECT_ID="your-project-id"
NEON_BRANCH="main"

# Database connection pooling
DB_POOL_MIN=2
DB_POOL_MAX=10
DB_IDLE_TIMEOUT=30000
DB_CONNECTION_TIMEOUT=2000

# =============================================================================
# APPLICATION CONFIGURATION
# =============================================================================
NODE_ENV=production
NEXT_PUBLIC_APP_URL="https://johorup.jpnj.gov.my"
NEXTAUTH_URL="https://your-site-name.netlify.app"
NEXTAUTH_SECRET="your-super-secure-32-character-secret-key-here"

# =============================================================================
# AUTHENTICATION & SECURITY
# =============================================================================
JWT_SECRET="your-jwt-secret-key-minimum-32-characters"
ENCRYPTION_KEY="your-32-character-encryption-key-here"
SESSION_SECRET="your-session-secret-key-here"

# NextAuth.js configuration
NEXTAUTH_SECRET="your-nextauth-secret-32-characters"
NEXTAUTH_URL="https://johorup.jpnj.gov.my"

# Google OAuth (SSO)
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# Password requirements
MIN_PASSWORD_LENGTH=8
REQUIRE_SPECIAL_CHARS=true
REQUIRE_NUMBERS=true

# =============================================================================
# FILE STORAGE (Cloudinary - Free Tier)
# =============================================================================
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"

# File upload limits
MAX_FILE_SIZE=10485760  # 10MB in bytes
ALLOWED_FILE_TYPES="pdf,doc,docx,xls,xlsx,jpg,jpeg,png"

# Cloudinary upload settings
CLOUDINARY_FOLDER="johorup"
CLOUDINARY_SECURE=true
CLOUDINARY_QUALITY="auto"

# =============================================================================
# EMAIL CONFIGURATION (Optional - for notifications)
# =============================================================================
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER="noreply@jpnj.gov.my"
SMTP_PASS="your-email-app-password"
FROM_EMAIL="Sistem JohorUP <noreply@jpnj.gov.my>"

# =============================================================================
# MONITORING & LOGGING
# =============================================================================
# Sentry for error tracking (optional)
SENTRY_DSN="https://your-sentry-dsn@sentry.io/project-id"
SENTRY_ENVIRONMENT="production"

# Analytics (optional)
NEXT_PUBLIC_GOOGLE_ANALYTICS="G-XXXXXXXXXX"

# Logging level
LOG_LEVEL="info"

# =============================================================================
# RATE LIMITING & SECURITY
# =============================================================================
# Rate limiting (requests per minute)
RATE_LIMIT_LOGIN=5
RATE_LIMIT_API=100
RATE_LIMIT_UPLOAD=10

# CORS settings
ALLOWED_ORIGINS="https://johorup.jpnj.gov.my,https://www.jpnj.gov.my"

# Security headers
ENABLE_CSP=true
ENABLE_HSTS=true

# =============================================================================
# FEATURE FLAGS
# =============================================================================
ENABLE_MAINTENANCE_MODE=false
ENABLE_USER_REGISTRATION=false
ENABLE_FILE_UPLOAD=true
ENABLE_EXCEL_EXPORT=true
ENABLE_ANALYTICS=true

# =============================================================================
# PERFORMANCE SETTINGS
# =============================================================================
# Cache settings (optional - can use Netlify Edge Functions)
CACHE_TTL=3600  # 1 hour

# CDN settings (Netlify provides CDN automatically)
CDN_URL="https://cdn.johorup.jpnj.gov.my"

# =============================================================================
# BACKUP CONFIGURATION (Neon provides automatic backups)
# =============================================================================
# Neon provides automatic backups and point-in-time recovery
# Additional backup settings (optional)
BACKUP_SCHEDULE="0 2 * * *"  # Daily at 2 AM
BACKUP_RETENTION_DAYS=30

# =============================================================================
# NOTIFICATION SETTINGS
# =============================================================================
# Admin notification emails
ADMIN_EMAILS="admin@jpnj.gov.my,koordinator@jpnj.gov.my"

# System alerts
ENABLE_ERROR_NOTIFICATIONS=true
ENABLE_MAINTENANCE_NOTIFICATIONS=true
ENABLE_BACKUP_NOTIFICATIONS=false  # Neon handles this

# =============================================================================
# INTEGRATION SETTINGS
# =============================================================================
# Government systems integration (if applicable)
GOV_API_ENDPOINT="https://api.gov.my/johor-education"
GOV_API_KEY="your-government-api-key"

# Single Sign-On (if applicable)
SSO_ENABLED=false
SSO_PROVIDER="azure-ad"
SSO_CLIENT_ID="your-sso-client-id"
SSO_CLIENT_SECRET="your-sso-client-secret"

# =============================================================================
# MAINTENANCE SETTINGS
# =============================================================================
MAINTENANCE_MODE=false
MAINTENANCE_MESSAGE="Sistem sedang diselenggara. Sila cuba lagi kemudian."
MAINTENANCE_ALLOWED_IPS="192.168.1.100,10.0.0.50"  # Admin IPs

# =============================================================================
# AUDIT & COMPLIANCE
# =============================================================================
ENABLE_AUDIT_LOG=true
AUDIT_RETENTION_DAYS=365
ENABLE_DATA_ENCRYPTION=true

# Privacy settings
DATA_RETENTION_YEARS=7
ENABLE_GDPR_COMPLIANCE=true

# =============================================================================
# DEVELOPMENT/DEBUG (Set to false in production)
# =============================================================================
DEBUG=false
ENABLE_DEBUG_LOGS=false
SHOW_ERROR_DETAILS=false

# =============================================================================
# COST OPTIMIZATION (Neon specific)
# =============================================================================
# Neon auto-scaling settings
NEON_AUTO_SUSPEND=true
NEON_SUSPEND_TIMEOUT=300  # 5 minutes of inactivity

# Connection optimization
NEON_POOLING=true
NEON_PREPARED_STATEMENTS=true

# =============================================================================
# NETLIFY SPECIFIC SETTINGS
# =============================================================================
# Build settings (handled by netlify.toml)
NETLIFY_BUILD_COMMAND="npm run build"
NETLIFY_PUBLISH_DIR=".next"

# Functions settings (if using Netlify Functions)
NETLIFY_FUNCTIONS_DIR="netlify/functions"

# Edge Functions settings (if using Netlify Edge Functions)
NETLIFY_EDGE_FUNCTIONS_DIR="netlify/edge-functions"