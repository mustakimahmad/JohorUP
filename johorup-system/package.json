{
  "name": "johorup-system",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "export": "next export",
    "start": "next start",
    "lint": "eslint",
    "type-check": "tsc --noEmit",
    "clear:mockup": "node scripts/clear-mockup-data.js",
    "clear:cache": "node scripts/clear-browser-cache.js",
    "complete:reset": "node scripts/complete-reset.js",
    "reset:start": "node scripts/reset-and-start.js",
    "auto:login": "node scripts/auto-login.js",
    "audit:setup": "node scripts/setup-audit-trail.js",
    "deploy:netlify": "bash scripts/setup-netlify.sh",
    "deploy:netlify-neon": "bash scripts/setup-netlify-neon.sh",
    "import:data": "node scripts/import-production-data.js",
    "import:neon": "node scripts/import-to-neon.js",
    "setup:neon": "node scripts/setup-neon-database.js",
    "test:neon": "node scripts/test-neon-connection.js",
    "fix:production": "node scripts/fix-production-schema.js",
    "test:production": "node scripts/test-production-fix.js",
    "backup:db": "pg_dump $DATABASE_URL > backups/backup_$(date +%Y%m%d_%H%M%S).sql",
    "health-check": "curl -f http://localhost:3000/api/health || exit 1"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cloudinary": "^2.0.1",
    "multer": "^1.4.5-lts.1",
    "next": "16.0.7",
    "node-fetch": "^3.3.2",
    "pg": "^8.11.3",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "recharts": "^3.5.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@netlify/plugin-nextjs": "^5.15.3",
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/multer": "^1.4.11",
    "@types/node": "^20",
    "@types/pg": "^8.10.9",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.0.7",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=8.0.0"
  }
}
